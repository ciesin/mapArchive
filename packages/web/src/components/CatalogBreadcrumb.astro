---
interface BreadcrumbSegment {
  label: string;
  spatialLevel?: string;
  href?: string;
}

interface Props {
  segments: BreadcrumbSegment[];
}

const { segments } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {segments.map((seg) => (
    <>
      <span aria-hidden="true">/</span>
      {seg.href ? (
        <a href={seg.href}>
          {seg.label}
          {seg.spatialLevel && <span class="bc-level">{seg.spatialLevel}</span>}
        </a>
      ) : (
        <span>
          {seg.label}
          {seg.spatialLevel && <span class="bc-level">{seg.spatialLevel}</span>}
        </span>
      )}
    </>
  ))}
</nav>

<style>
  .bc-level {
    font-size: 0.72em;
    font-weight: 400;
    opacity: 0.55;
    margin-left: 0.3em;
    text-transform: lowercase;
  }
</style>
