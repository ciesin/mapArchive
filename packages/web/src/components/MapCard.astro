---
interface Props {
  href: string;
  title: string;
  description?: string | null;
  theme?: string | null;
  spatialLevel?: string | null;
  datetime?: string | null;
  thumbnailUrl?: string | null;
}

const { href, title, description, theme, spatialLevel, datetime, thumbnailUrl } = Astro.props;
const dateStr = datetime ? new Date(datetime).getFullYear().toString() : '';
const badgeClass = theme ? `badge badge-${theme.replaceAll(':', '-')}` : 'badge';
---

<a href={href} class="card">
  <div class="card-image-wrapper">
    {thumbnailUrl ? (
      <img
        src={thumbnailUrl}
        alt={title}
        class="card-image"
        loading="lazy"
        decoding="async"
        width="400"
        height="283"
      />
    ) : (
      <div class="card-image card-image-placeholder"></div>
    )}
  </div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <div class="card-meta">
      {theme && <span class={badgeClass}>{theme}</span>}
      {spatialLevel && <span class="card-tag">{spatialLevel}</span>}
      {dateStr && <span class="card-tag">{dateStr}</span>}
    </div>
    {description && <p class="card-desc">{description}</p>}
  </div>
</a>
