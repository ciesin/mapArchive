---
interface Props {
  overviewUrl: string;
  originalUrl: string;
  title: string;
}

const { overviewUrl, originalUrl, title } = Astro.props;
---

<div class="viewer-wrapper">
  <div class="viewer-toolbar">
    <a href={originalUrl} target="_blank" rel="noopener" class="btn">
      Full Resolution
    </a>
  </div>
  <div class="map-viewer">
    <img src={overviewUrl} alt={title} />
  </div>
</div>
