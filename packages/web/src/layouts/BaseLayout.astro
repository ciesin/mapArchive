---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'CIESIN Map Archive', description = 'Searchable archive of high-resolution maps' } = Astro.props;
const pageTitle = title === 'CIESIN Map Archive' ? title : `${title} | CIESIN Map Archive`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" />
  </head>
  <body>
    <nav class="nav">
      <div class="container nav-inner">
        <a href="/" class="nav-brand" aria-label="CIESIN Map Archive home">
          <img
            src="/Columbia_University_Logo-Crown_white.png"
            alt="Columbia University logo"
            class="nav-logo"
          />
        </a>

        <div class="nav-links">
          <a href="/catalog">Catalog</a>
          <a href="/search">Search</a>
          <a href="/about">About</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>©2026 Columbia University</p>
      </div>
    </footer>
  </body>
</html>
