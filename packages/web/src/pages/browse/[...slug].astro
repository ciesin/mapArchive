---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogBreadcrumb from '../../components/CatalogBreadcrumb.astro';
import MapCard from '../../components/MapCard.astro';
import {
  fetchCollection,
  fetchItemsByLinks,
  collectionUrl,
  extractChildSlug,
  slugToLabel,
} from '../../lib/stac-client';

const ITEMS_FETCH_CAP = 50; // max items fetched per request

const slugParam = Astro.params.slug ?? '';

if (!slugParam) {
  return Astro.redirect('/catalog');
}

const slugParts = slugParam.split('/');

let collection;
try {
  collection = await fetchCollection(slugParam);
} catch {
  return Astro.redirect('/catalog');
}

const baseUrl = collectionUrl(slugParam);

const childLinks    = collection.links.filter((l) => l.rel === 'child');
const allItemLinks  = collection.links.filter((l) => l.rel === 'item');

// Fetch items up to cap; show count note if catalog has more
const fetchableLinks = allItemLinks.slice(0, ITEMS_FETCH_CAP);
const items = await fetchItemsByLinks(fetchableLinks, baseUrl);

const moreThanFetched = allItemLinks.length > ITEMS_FETCH_CAP;

const childSpatialLevel = childLinks.find((l) => l['ciesin:spatial_level'])?.['ciesin:spatial_level'];
const toSentenceCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// slugParts[0] is the theme; admin levels start at index 1, aligned with admin_path / spatial_level_path
const spatialLevelPath = collection['ciesin:spatial_level_path'] ?? [];

const breadcrumbSegments = [
  { label: 'Catalog', href: '/catalog' },
  ...slugParts.map((part, i) => {
    const isLast = i === slugParts.length - 1;
    const adminIndex = i - 1; // -1 for the theme segment, 0+ for admin levels
    const spatialLevel = adminIndex >= 0 ? (spatialLevelPath[adminIndex] || undefined) : undefined;
    return {
      label: isLast ? collection.title : slugToLabel(part),
      spatialLevel,
      href: isLast ? undefined : `/browse/${slugParts.slice(0, i + 1).join('/')}`,
    };
  }),
];
---

<BaseLayout title={collection.title} description={collection.description}>
  <div class="container section">
    <CatalogBreadcrumb segments={breadcrumbSegments} />

    <h1 class="section-title">
      {collection.title}
      {collection['ciesin:spatial_level'] && (
        <span class="spatial-chip">{collection['ciesin:spatial_level']}</span>
      )}
    </h1>
    {collection.description && (
      <p class="collection-desc">{collection.description}</p>
    )}

    {/*  Maps  */}
    {items.length > 0 && (
      <section class="items-section">
        <h2 class="subsection-heading">
          Maps
          <span class="count-badge">{allItemLinks.length}</span>
        </h2>

        <div class="card-grid">
          {items.map((item) => (
            <MapCard
              href={`/map/${slugParam}/${item.id}`}
              title={item.properties.title}
              description={item.properties.description}
              theme={item.properties['ciesin:theme']}
              spatialLevel={item.properties['ciesin:spatial_level']}
              datetime={item.properties.datetime}
              thumbnailUrl={item.assets.thumbnail?.href ?? item.assets.overview?.href ?? null}
            />
          ))}
        </div>
        {moreThanFetched && (
          <p class="cap-note">
            Showing first {ITEMS_FETCH_CAP} of {allItemLinks.length} maps.
            Sub-collections below contain additional items.
          </p>
        )}
      </section>
    )}

    {/*  Sub-collections  */}
    {childLinks.length > 0 && (
      <section class="children-section">
        <h2 class="subsection-heading">
          {childSpatialLevel ? toSentenceCase(`${childSpatialLevel} sub-collections`) : 'Sub-collections'}
          <span class="count-badge">{childLinks.length}</span>
        </h2>

        <div class="child-list">
          {childLinks.map((link) => {
            const childSlug = extractChildSlug(link.href);
            return (
              <a href={`/browse/${slugParam}/${childSlug}`} class="child-row">
                <span class="child-text">
                  <span class="child-name">{link.title ?? slugToLabel(childSlug)}</span>
                  {link['ciesin:spatial_level'] && (
                    <span class="child-level">{link['ciesin:spatial_level']}</span>
                  )}
                </span>
                <span class="arrow" aria-hidden="true"></span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {childLinks.length === 0 && items.length === 0 && (
      <p class="empty-state">No content in this collection yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  .spatial-chip {
    display: inline-block;
    font-size: 0.5em;
    font-weight: 500;
    vertical-align: middle;
    margin-left: 0.6em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background: var(--color-bg);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .child-level {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
    text-transform: lowercase;
  }

  .collection-desc {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 700px;
  }

  /*  Section headings  */
  .items-section {
    margin-bottom: 2.5rem;
  }
  .children-section {
    margin-top: 0;
  }
  .subsection-heading {
    font-size: 1.125rem;
    margin-bottom: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .count-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.0625rem 0.5rem;
    line-height: 1.6;
  }

  /*  Sub-collection grid  */
  .child-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.375rem;
  }
  .child-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.125rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }
  .child-row:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
  }
  .child-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .child-name {
    font-size: 0.9375rem;
  }
  .arrow {
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: 0.75rem;
  }

  .cap-note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /*  Empty state  */
  .empty-state {
    color: var(--color-text-muted);
    padding: 3rem 0;
    text-align: center;
  }
</style>
