---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogBreadcrumb from '../../components/CatalogBreadcrumb.astro';
import { fetchCatalog, fetchCollection, extractChildSlug } from '../../lib/stac-client';

const catalog = await fetchCatalog();
const childLinks = catalog.links.filter((l) => l.rel === 'child');

const collections = (
  await Promise.all(
    childLinks.map(async (link) => {
      const slugPath = extractChildSlug(link.href);
      try {
        const col = await fetchCollection(slugPath);
        return { slugPath, col };
      } catch {
        return null;
      }
    }),
  )
).filter((x): x is NonNullable<typeof x> => x !== null);
---

<BaseLayout title="Catalog" description="Browse all map collections">
  <div class="container section">
    <CatalogBreadcrumb segments={[{ label: 'Catalog' }]} />
    <h1 class="section-title">STAC Catalog</h1>
    <p class="catalog-intro">Browse map collections by use case.</p>

    <div class="collection-list">
      {collections.map(({ slugPath, col }) => (
        <a href={`/browse/${slugPath}`} class="collection-row">
          <div>
            <h2>{col.title}</h2>
            <p>{col.description}</p>
          </div>
          <div class="collection-meta">
            <span class={`badge badge-${(col['ciesin:theme'] ?? slugPath).replaceAll(':', '-')}`}>
              {col['ciesin:theme'] ?? slugPath}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
