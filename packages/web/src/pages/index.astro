<style>
  /* Hero */
  .hero {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0 3rem;
    text-align: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-logo-wrap {
    margin-bottom: 0.5rem;
  }

  .hero-logo {
    width: 85%;
	height: auto;
    display: block;
    margin: 0 auto;
  }

  .hero-sub {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero-title {
    font-family: 'Inter Tight', Arial, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--ciesin-accent);
    border: none;
    padding: 0;
    margin: 0;
  }

  .hero-desc {
    max-width: 560px;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0.25rem 0 0.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* About content (reuse global .about-content, override h2 scoped styles) */
  .about-content h2 {
    font-size: 1rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .about-content p {
    line-height: 1.7;
  }

  /* Dark mode: hero bg darkens to match surface */
  @media (prefers-color-scheme: dark) {
    .hero {
      background: var(--color-surface);
    }

    .hero-logo {
      filter: brightness(0) invert(1);
    }
  }
</style>
