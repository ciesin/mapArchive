---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CIESIN Map Archive" description="Searchable archive of high-resolution maps from CIESIN at Columbia University">

  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-logo-wrap">
        <a href="https://ciesin.columbia.edu/">
        <img
          src="/CCS_NewWebBanners_vf.jpg"
          alt="CIESIN – Center for Integrated Earth System Information"
          class="hero-logo"
        />
        </a>
      </div>
      <!-- <p class="hero-sub">Center for Integrated Earth System Information</p>
      <h1 class="hero-title">Map Archive</h1>
      <p class="hero-desc">
        A searchable digital archive of high-resolution maps produced by CIESIN at Columbia University,
        catalogued as interoperable STAC items. -->
    </div>
  </section>

  <div class="container" id="home-text">
	  <br>
      <p>
        The <strong>CIESIN Map Archive</strong> is a searchable digital archive of high-resolution static maps
        authored and maintained by the <a href="https://www.ciesin.columbia.edu/">Center for Integrated
        Earth System Information (CIESIN)</a> at Columbia University.
      </p>
      <p>
        <em>
        This archive is a work in progress; Version 1.0 will include a limited set of maps of the Democratic Republic of the Congo produced between late 2024 and early 2026 as part of the GRID3 project's collaboration with Gavi, the Vaccine Alliance's Equity Accelerator Fund (EAF).
        </em>
      </p>

      <div class="hero-actions">
        <a href="/catalog" class="btn btn-primary">Browse the Archive</a>
      </div>

    </div>
  </div>

</BaseLayout>

<style>

  .hero {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0 3rem;
    text-align: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-logo-wrap {
    margin-bottom: 0.5rem;
  }

  .hero-logo {
    width: 85%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  #home-text {
    /* max-width: 700px; */
    margin: 2rem auto;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }
    .hero-logo {
      width: 95%;
    }
  }

  @media (prefers-color-scheme: dark) {
    .hero {
      background: var(--color-surface);
    }
    /* .hero-logo {
      filter: brightness(0) invert(1);
    } */
  }

</style>
